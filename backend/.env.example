# Local single-owner development. Do not expose the unauthenticated API on a public address.
DATABASE_URL=sqlite:///./data/live.db
DATA_MODE=live
LLM_MODE=extractive
TIMEZONE=America/Los_Angeles
ADMIN_TOKEN=
# Optional live model integration. Source ingestion never requires a model key.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_RESPONSE_FORMAT=json_schema
LLM_MAX_OUTPUT_TOKENS=700
AUTO_INIT_DB=true

# v0.2: run_local.py --durable starts a separate worker and enables this mode.
TASK_MODE=local
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=120
JOB_MAX_ATTEMPTS=3
RETRY_BASE_SECONDS=10
# file writes local .eml previews. It NEVER sends mail to an external mailbox.
DELIVERY_TRANSPORT=file
OUTBOX_DIR=./data/outbox
MAIL_FROM=ai-pulse@example.invalid
MAIL_TO=reader@example.invalid
# Live SMTP is opt-in; use a trusted server and one explicitly configured recipient.
# The schedule is disabled by default, and synthetic replay cannot use SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=20

# DNS + redirects + streaming all share a killable process deadline.
FETCH_DEADLINE_SECONDS=20
# Bounded research including all model turns; unknown calls are never replayed.
RESEARCH_DEADLINE_SECONDS=60
